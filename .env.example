# BoloSIP local settings
# ----------------------
# Copy this file to ".env" in the same folder and fill in your values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# ".env" is git-ignored, so your key never reaches GitHub.
# Never put a real key in THIS file (.env.example is committed).
# A variable set in your real environment overrides the value in .env.

# --- Groq (optional LLM rephrasing) ------------------------------------------
# Get a key at https://console.groq.com/keys
# Leave empty to run without the LLM: answers then use the source text directly.
GROQ_API_KEY=

# Groq model ID. Check current production models at
# https://console.groq.com/docs/models
BOLOSIP_MODEL=openai/gpt-oss-120b

# auto = use Groq if GROQ_API_KEY is set | on = require it | off = never call Groq
BOLOSIP_LLM=auto

# --- Retrieval (Phase 3) ------------------------------------------------------
# auto = local embeddings + ChromaDB if installed and built, else keyword search (BM25)
# embed = require embeddings | bm25 = always keyword search
BOLOSIP_RETRIEVER=auto
BOLOSIP_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
BOLOSIP_MODEL_CACHE=.cache/models
BOLOSIP_CHROMA_DIR=data/chroma

# --- Server ------------------------------------------------------------------
BOLOSIP_HOST=127.0.0.1
BOLOSIP_PORT=8000

# --- Hosting (Doc/deployment-plan.md) -----------------------------------------
# Leave these empty on the laptop. On Railway: see the variables table in the plan.
# A platform's PORT variable, when set, wins over BOLOSIP_PORT.
# Public host names served over HTTPS (comma-separated); defaults to RAILWAY_PUBLIC_DOMAIN.
BOLOSIP_PUBLIC_HOSTS=
# 1 = behind a trusted proxy (Railway's edge): visitor IP from X-Real-IP, HSTS over HTTPS.
BOLOSIP_TRUST_PROXY=0
# Delete chats not used for this many days; 0 = keep them.
BOLOSIP_RETENTION_DAYS=0

# --- Data files (relative paths are inside the project folder) ---------------
BOLOSIP_DB=data/bolosip.sqlite3
BOLOSIP_CORPUS=data/corpus.json

# --- Rate limits per client IP, per minute -----------------------------------
BOLOSIP_RATE_MSG=30
BOLOSIP_RATE_ALL=120

# --- Testing only --------------------------------------------------------------
# BOLOSIP_SKIP_DOTENV=1 stops config.py reading this file. It only works when set
# in the real environment (setting it inside .env has no effect), e.g. to run the
# app or tests with settings from the environment alone.
