# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonl,yml,yaml,html,css,js}]
indent_size = 2

[*.md]
# Two trailing spaces can mean a line break in Markdown.
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[data/raw/*.html]
# Saved source pages: keep exactly as fetched.
trim_trailing_whitespace = false
insert_final_newline = false
